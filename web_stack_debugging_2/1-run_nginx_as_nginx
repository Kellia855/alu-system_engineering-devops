#!/bin/bash
# Configures Nginx to run as the nginx user and listen on port 8080

set -e

# Ensure nginx config uses nginx user
sed -i 's/^user .*/user nginx;/' /etc/nginx/nginx.conf

# Update default site config to listen on port 8080
sed -i 's/listen 80 default_server;/listen 8080 default_server;/g' /etc/nginx/sites-available/default
sed -i 's/listen \[::\]:80 default_server;/listen \[::\]:8080 default_server;/g' /etc/nginx/sites-available/default

# Start Nginx as foreground process
nginx -g 'daemon off;'
