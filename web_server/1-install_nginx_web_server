#!/usr/bin/env bash
# This script installs nginx and sets up a custom home page with "Holberton School for the win!"

# Update package index and install nginx
apt-get update -y
apt-get install nginx -y

# Make sure nginx starts (without systemctl)
service nginx start || /etc/init.d/nginx start

# Create a custom index.html with the required string
echo "Holberton School for the win!" > /var/www/html/index.html

# Ensure nginx is running using service instead of systemctl
service nginx start

