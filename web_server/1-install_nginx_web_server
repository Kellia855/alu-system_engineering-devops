#!/usr/bin/env bash
# Installs nginx, sets up a custom index page, and ensures nginx is running without using systemctl

# Install nginx silently
apt-get update -y
apt-get install -y nginx

# Set custom index.html content
echo "Holberton School for the win!" > /var/www/html/index.nginx-debian.html

# Ensure nginx is running using service instead of systemctl
service nginx start

