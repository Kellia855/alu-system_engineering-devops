#!/usr/bin/env bash
# Installs nginx, sets up a custom index page, and ensures nginx is running without using systemctl

# Install nginx if not installed
if ! dpkg -l | grep -q nginx; then
  sudo apt update
  sudo apt install -y nginx
fi

# Ensure nginx is running
sudo systemctl start nginx
sudo systemctl enable nginx

# Replace the default index page with "Holberton School"
echo "Holberton School" | sudo tee /var/www/html/index.nginx-debian.html > /dev/null

# Reload nginx to apply changes
sudo systemctl reload nginx


